# xat: valores obrigatorios
BOT_USER=usuario_do_bot
BOT_APIKEY=chave_api_do_bot
BOT_CHAT_ID=123456789

# xat: perfil opcional
BOT_NICK="Bot"
BOT_STATUS=""
