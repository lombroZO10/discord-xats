# Credenciais da conta do bot
BOT_USER=usuario_do_bot
BOT_APIKEY=chave_api_do_bot

# ID numerico do chat do xat
BOT_CHAT_ID=123456789

# Perfil exibido no chat
BOT_NICK=Bot
BOT_STATUS=
BOT_AVATAR=171
BOT_HOME=
BOT_PCBACK=

# Conexao oficial do bot
WEBSOCKET_URL=wss://bots.xat.com/v2
WEBSOCKET_ORIGIN=https://xat.com

# Limite do backoff de reconexao, em milissegundos
BOT_RECONNECT_MAX_MS=30000

# Bot e canal de destino no Discord
DISCORD_BOT_TOKEN=token_do_bot_discord
DISCORD_CHANNEL_ID=123456789012345678
DISCORD_ACTIVITY=xat.com
